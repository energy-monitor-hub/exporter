# Copy to .env and fill in; .env is gitignored.

# EcoFlow app account (private MQTT API). Optional: leave these empty and enter them on the
# exporter's status page (http://127.0.0.1:9101/) instead, where they are stored encrypted
# (README, "Setting up the EcoFlow account"). When set here, they win and the page is read-only.
ECOFLOW_USERNAME=
ECOFLOW_PASSWORD=
DEVICE_SN=
# Optional. API host for login; default api.ecoflow.com. EU accounts can also use api-e.ecoflow.com.
# ECOFLOW_API_HOST=api-e.ecoflow.com

# Device source (src/sources). Today only ecoflow-mqtt.
# SOURCE=ecoflow-mqtt

# Supabase. The exporter writes as you: log in once (status page "Log in", or README,
# "Exporter login") and approve it on the dashboard. No service_role key here.
# Cloud: https://<project-ref>.supabase.co and the anon / publishable key (public, the
# same one the dashboard uses; the dashboard's Exporters page shows both).
# Local Supabase (dashboard repository, `make db-start`): host.docker.internal works from a
# devcontainer and from the exporter container.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=

# Optional exporter login settings (defaults shown)
# OAUTH_CLIENT_NAME="Exporter <date>"       # how it is listed on the dashboard's "Exporters" page
# OAUTH_CALLBACK_PORT=9102                   # browser comes back to http://127.0.0.1:9102/callback
# OAUTH_TOKEN_PATH=data/oauth.json           # tokens (secret; Docker: /data/oauth.json on the volume)
# CREDENTIALS_PATH=data/credentials.json     # setup page credentials, encrypted (Docker: /data/credentials.json)

# Signed decoder packs (docs/DECODER_PACKS.md). Data only, never code; no updates without an index URL
# and a trusted key. The request sends no identifiers.
# DECODER_INDEX_URL=https://<your-site>/decoders/index.json
# DECODER_UPDATES=auto                       # off | notify (show only) | auto (use verified packs)
# DECODER_PUBLIC_KEYS=                       # extra Ed25519 keys, base64 SPKI, comma separated (forks)
# DECODER_CACHE_DIR=data/decoders            # Docker: /data/decoders on the volume

# New exporter versions (docs/UPDATES.md): shown on the status page, never installed by itself.
# EXPORTER_RELEASES_URL=https://<your-site>/releases/releases.json
# EXPORTER_UPDATES=notify                    # notify | off
# EXPORTER_CHANNEL=stable                    # stable | beta

# Exporter HTTP port: local status page (http://127.0.0.1:9101/) and /healthz
HEALTH_PORT=9101
# Optional. Address of the status page as your browser sees it (its login comes back to
# <UI_URL>/callback); change it if you publish the port elsewhere.
# UI_URL=http://127.0.0.1:9101
# Optional. Extra host names the status page answers to (localhost and IP addresses always work).
# UI_ALLOWED_HOSTS=nas.local
# A local container domain works too, e.g. OrbStack's exporter.ecoflow.orb.local; the
# credentials form and updates still answer only on 127.0.0.1.
# Optional. Address the status page listens on. Default 127.0.0.1 (this computer only); the
# Docker image sets 0.0.0.0 and publishes the port on the host's 127.0.0.1. Natively, set
# 0.0.0.0 only to open the page to your LAN: the credentials form still answers only to
# connections from this computer.
# LISTEN_HOST=127.0.0.1

# Optional exporter tuning (defaults shown)
# SAMPLE_INTERVAL_S=10          # one row in telemetry_raw / pack_raw every N seconds
# MQTT_SILENCE_TIMEOUT_S=180    # reconnect if MQTT is silent this long (0 = off)
# QUOTA_EVERY_S=300             # ask the device for a full snapshot every N seconds
# BUFFER_PATH=data/buffer.sqlite  # local queue for rows not yet in Supabase (Docker: /data)
