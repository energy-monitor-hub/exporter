# Supply-chain rules (see CLAUDE.md, "Dependencies"). Needs npm >= 11.10.
# Exact versions only: `npm install foo` writes "foo": "1.2.3", never "^1.2.3".
save-exact=true
# Quarantine: never resolve a version published less than 7 days ago.
min-release-age=7
# Fail if node/npm don't match "engines" (npm 10 ignores min-release-age silently).
engine-strict=true
# Dependency install scripts run only if approved in package.json "allowScripts"
# (`npm install-scripts ls` / `npm install-scripts approve <pkg>`).
strict-allow-scripts=true
